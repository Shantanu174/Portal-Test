<%- include('partials/header', { pageCss: 'prep.css' }) %>

  <main class="page-wrapper">
    <div class="prep-header">
      <div class="container">
        <div class="section-label">📚 Interview Prep</div>
        <h1 class="section-title">Master Every <span class="highlight">Interview Round</span></h1>
        <p class="section-subtitle">Structured notes, formulas, and practice problems for Aptitude, DSA, Technical CS, and HR rounds.</p>

        <div class="prep-overview">
          <div class="overview-stat">
            <div class="overview-num" style="color:var(--accent-primary);">500+</div>
            <div class="overview-label">Aptitude Qs</div>
          </div>
          <div class="overview-stat">
            <div class="overview-num" style="color:var(--accent-teal);">450+</div>
            <div class="overview-label">DSA Problems</div>
          </div>
          <div class="overview-stat">
            <div class="overview-num" style="color:var(--accent-orange);">4 Core</div>
            <div class="overview-label">CS Subjects</div>
          </div>
          <div class="overview-stat">
            <div class="overview-num" style="color:var(--accent-pink);">100+</div>
            <div class="overview-label">HR Questions</div>
          </div>
        </div>
      </div>
    </div>

    <!-- TABS NAVIGATION -->
    <div class="prep-tabs-nav">
      <div class="container">
        <div class="prep-tabs">
          <button class="prep-tab-btn active" data-tab="aptitude">🔢 Aptitude</button>
          <button class="prep-tab-btn" data-tab="technical">💻 Technical (Core CS)</button>
          <button class="prep-tab-btn" data-tab="hr">🤝 HR Round</button>
        </div>
      </div>
    </div>

    <div class="container section">
      <!-- 1. APTITUDE SECTION -->
      <div class="tab-pane active" id="tab-aptitude">
        <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">Aptitude Preparation Modules</h2>
        <div class="grid-2">
          <% prepData.aptitude.forEach(cat => { %>
            <div class="card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:1rem;">
                <div style="font-size:1.8rem;"><%= cat.icon %></div>
                <h3 style="font-size:1.2rem;font-weight:700;"><%= cat.name %></h3>
              </div>
              <div style="display:flex;flex-direction:column;gap:1rem;">
                <% cat.topics.forEach(t => { %>
                  <div style="background:var(--bg-glass);padding:1rem;border-radius:var(--radius-md);border:1px solid var(--border-color);">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                      <span style="font-weight:600;"><%= t.name %></span>
                      <span class="badge badge-primary"><%= t.problemsCount %> Problems</span>
                    </div>
                    <p style="font-size:0.85rem;color:var(--text-secondary);"><%= t.keyNotes %></p>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- 2. TECHNICAL CORE CS SECTION -->
      <div class="tab-pane hidden" id="tab-technical">
        <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">Core Computer Science Subjects</h2>
        <div class="grid-2">
          <% prepData.technical.forEach(sub => { %>
            <div class="card">
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:1rem;">
                <div style="font-size:1.8rem;"><%= sub.icon %></div>
                <h3 style="font-size:1.2rem;font-weight:700;"><%= sub.subject %></h3>
              </div>
              
              <div style="margin-bottom:1rem;">
                <h4 style="font-size:0.85rem;text-transform:uppercase;color:var(--accent-teal);letter-spacing:1px;margin-bottom:8px;">Key Concepts</h4>
                <ul style="padding-left:1.2rem;color:var(--text-secondary);font-size:0.85rem;display:flex;flex-direction:column;gap:6px;">
                  <% sub.keyConcepts.forEach(c => { %>
                    <li><%= c %></li>
                  <% }); %>
                </ul>
              </div>

              <div>
                <h4 style="font-size:0.85rem;text-transform:uppercase;color:var(--accent-orange);letter-spacing:1px;margin-bottom:8px;">Frequently Asked Questions</h4>
                <ul style="padding-left:1.2rem;color:var(--text-primary);font-size:0.85rem;display:flex;flex-direction:column;gap:4px;">
                  <% sub.sampleQuestions.forEach(q => { %>
                    <li><%= q %></li>
                  <% }); %>
                </ul>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- 3. HR ROUND SECTION -->
      <div class="tab-pane hidden" id="tab-hr">
        <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:1.5rem;">Behavioral & HR Round Mastery</h2>
        <div class="card">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:1.5rem;">
            <div style="font-size:2rem;">🤝</div>
            <div>
              <h3 style="font-size:1.25rem;font-weight:700;">Common HR Questions & Answering Frameworks</h3>
              <p style="color:var(--text-secondary);font-size:0.85rem;">Master the STAR technique and structure your answers with confidence.</p>
            </div>
          </div>

          <div style="display:flex;flex-direction:column;gap:1.5rem;">
            <% prepData.hr[0].questions.forEach(qItem => { %>
              <div style="background:var(--bg-glass);padding:1.25rem;border-radius:var(--radius-md);border:1px solid var(--border-color);">
                <div style="font-weight:700;font-size:1rem;color:var(--text-primary);margin-bottom:6px;">Q: <%= qItem.q %></div>
                <div style="font-size:0.875rem;color:var(--text-secondary);line-height:1.6;">
                  <strong style="color:var(--accent-primary);">Recommended Strategy:</strong> <%= qItem.framework %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </main>

<%- include('partials/footer', { pageJs: 'prep.js' }) %>
