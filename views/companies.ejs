<%- include('partials/header', { pageCss: 'companies.css' }) %>

  <main class="page-wrapper">
    <div class="companies-header">
      <div class="container">
        <div class="section-label">🏢 Company Profiles</div>
        <h1 class="section-title">Crack Any <span class="highlight">Company Interview</span></h1>
        <p class="section-subtitle">Detailed hiring process, exam patterns, syllabus, eligibility criteria, and insider tips for top tech companies.</p>

        <div class="companies-search-row mt-6">
          <div class="search-bar" style="flex:1;max-width:500px;">
            <span class="search-icon">🔍</span>
            <input type="text" id="companySearchInput" placeholder="Search by company name, role, or skills...">
          </div>
          <div class="filter-chips" id="companyFilterChips">
            <button class="chip active" data-filter="all">All Companies (<%= companies.length %>)</button>
            <button class="chip" data-filter="product">Product / FAANG</button>
            <button class="chip" data-filter="service">IT Services</button>
            <button class="chip" data-filter="mnc">Global MNCs</button>
          </div>
        </div>
      </div>
    </div>

    <!-- FEATURED COMPANIES -->
    <div class="container section">
      <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:1.5rem;">Featured Companies</h2>
      <div class="featured-companies-grid" id="companiesGrid">
        <% companies.forEach(company => { %>
          <div class="featured-company-card" data-category="<%= company.category.join(' ') %>" data-name="<%= company.name.toLowerCase() %>" onclick="openCompanyModal('<%= company.id %>')">
            <div class="company-logo-lg" style="background:<%= company.bg %>20;border-color:<%= company.bg %>50;"><%= company.logo %></div>
            <div class="fc-name"><%= company.name %></div>
            <div class="fc-tagline"><%= company.tagline %></div>
            
            <div class="fc-stats">
              <div class="fc-stat">
                <div class="fc-stat-val" style="color:var(--accent-primary);"><%= company.openRoles %></div>
                <div class="fc-stat-label">Open Roles</div>
              </div>
              <div class="fc-stat">
                <div class="fc-stat-val" style="color:var(--accent-orange);"><%= company.difficulty %></div>
                <div class="fc-stat-label">Difficulty</div>
              </div>
              <div class="fc-stat">
                <div class="fc-stat-val" style="color:var(--accent-teal);"><%= company.eligibility.cgpa.split(' ')[0] %></div>
                <div class="fc-stat-label">Min CGPA</div>
              </div>
            </div>

            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:1.25rem;"><%= company.description.substring(0, 110) %>...</p>

            <button class="btn btn-secondary btn-sm" style="width:100%;justify-content:center;">View Hiring Process →</button>
          </div>
        <% }); %>
      </div>
    </div>
  </main>

  <!-- COMPANY DETAIL MODAL -->
  <div class="modal-overlay" id="companyModal">
    <div class="modal" id="modalInner" style="max-width:750px;">
      <div id="companyModalBody"></div>
      <div style="margin-top:1.5rem;display:flex;justify-content:flex-end;">
        <button class="btn btn-secondary" onclick="closeCompanyModal()">Close Guide</button>
      </div>
    </div>
  </div>

<%- include('partials/footer', { pageJs: 'companies.js' }) %>
